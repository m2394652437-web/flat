.{
    // environment variables
    // used by processes spawned by flat-wm
    .env = .{
        // .{ "key", "value" },
    },

    // working direction of processes spawned by flat-wm
    .working_directory = .home,

    .startup_cmds = .{
        // .{ "swaybg", "-i", "/path/to/wallpaper" },
    },

    // null
    // or
    // .{ .name = []const u8, .size = u32 }
    .xcursor_theme = null,

    // ?u32
    // solid color background
    // note: set this to null if you use other wallpaper program like `swaybg`, orelse it will be covered by this and unable to see
    .background = 0x33000000,

    .bar = .{
        .show_default = true,
        // .top
        // .bottom
        .position = .top,

        .font = "monospace:size=10",

        .scheme = .{
            .normal = .{
                .fg = 0x828bb8ff,
                .bg = 0x1b1d2bd0,
            },
            .select = .{
                .fg = 0x444a73ff,
                .bg = 0xc8d3f5d0,
            },
        },

        // set null to disable tags part
        .tags = .{
            // workspaces show on bar
            .tags = .{ "1", "2", "3", "4", "5", "6", "7", "8", "9" },

            // click callback
            // each part supports left/right/middle/side/extra/forward/back/task
            // set null to disable
            .click = .{
                // could use 0 there because it will be replaced with the workspace clicked
                .left = .{ .set_workspace = .{ .workspace = 0 } },
                .middle = .{ .set_window_workspace = .{ .workspace = 0 } },
            },
        },
        // set null to disable mode part
        .mode = .{
            // mode tags show on bar
            // display full mode string by default
            .tags = .{
                .{ "default", "" },         // hide mode tag in default mode
                .{ "passthrough", "P" },    // only show "P" on bar in passthrough mode
                .{ "floating", "F" },       // only show "F" on bar in floating mode
            },

            .click = .{
                .left = .{ .switch_mode = .{ .mode = "default" } },
            },
        },
        // set null to disable layout part
        .layout = .{
            // layout tag shows on bar
            // {{?}} will be replaced with managed window count, when the count is 0, `?` will be used as replacement.
            // e.g. [{{=}}], when managed window count > 0, [N] will be showed, else [=] will be showed
            .tag = "[==]",

            .click = .{},
        },
        // set null to disable title part
        .title = .{
            .click = .{
                .left = .zoom,
            },
        },
        // set null to disable status part
        .status = .{
            .data = .{ .text = "^#ff0000ffk^#00ff00ffw^#0000ffffm" }, // .stdin or .{ .fifo = "fifo file path" }, could use ^#RGBA to switch text color, and use ^#! to switch back to default color

            .click = .{
                .middle = .{ .spawn = .{ .argv = .{ "foot" } } },
            },
        },

        // override colors
        .override_colors = .{
            // areas:
            //      .tags
            //      .{ .mode = "floating" or other modes }, null will match all mode
            //      .layout
            //      .title
            //      .status
            //
            // scheme is a struct, no need to specify all fields:
            //      .{
            //          .normal = .{
            //              .fg = u32,
            //              .bg = u32,
            //          },
            //          .select = .{
            //              .fg = u32,
            //              .bg = u32,
            //          }
            //      }
            //
            // mode, layout and status will only use the `normal` color
            // tags and title will use both `normal` and `select` color
            //

            // set scheme for mode tag
            .{
                .area = .{ .mode = null },
                .scheme = .{
                    .normal = .{
                        .fg = 0x444a73ff,
                        .bg = 0xc8d3f5d0,
                    }
                }
            },
        }
    },

    .single_tagset = false,

    // workspaces: mod+1..mod+9 switch between 9 workspaces per output, each one is a plane
    // of rows (tags) stacked vertically, mod+up/mod+down switch between the rows.
    // niri-like dynamic rows (ignored with single_tagset):
    // empty rows are removed and the occupied ones are packed to the front, so there is
    // always exactly one empty row after them. Switching to the next/previous row past
    // either end moves the row from the other end over, so the rows form a ring.
    .dynamic_tags = true,

    .sloppy_focus = false,

    // .none
    // .on_focus_changed: warp cursor to the center of window focused
    // .on_output_changed: warp cursor to the center of output focused
    .cursor_warp = .none,

    // touchpad swipe gestures, read from libinput directly (requires the `input` group)
    //  horizontal swipe: scroll the windows
    //  vertical swipe:   switch to the next/previous row of the workspace
    //  workspace_fingers horizontal swipe: switch to the next/previous workspace
    .gesture = .{
        .enabled = true,
        // number of fingers of the swipe
        .fingers = 3,
        // a horizontal swipe with this many fingers switches to the next/previous workspace, 0: off
        .workspace_fingers = 4,
        // minimum (unaccelerated) touchpad distance for a swipe to switch window/tag
        .threshold = 100,
        // pixels moved per unit of touchpad movement
        .scroll_factor = 1.5,
        .tag_scroll_factor = 2.0,
        // a fling continues as if the fingers kept their release speed for this many seconds
        .fling = 0.1,
        // how far (pixels) a drag can stretch past the last window/tag
        .rubber_band = 120,
        // duration of the settle animation
        .settle_ms = 250,
        // also animate focus/tag changes made by key bindings, clicks, new windows...
        .animate_bindings = true,
        // overview shows the workspace zoomed out by this factor (needs river_window_scale_v1)
        .overview_zoom = 0.5,
    },

    // if to remember last floating geometry
    .remember_floating_geometry = false,

    .auto_swallow = true,

    // .top: stack top
    // .bottom: stack bottom
    // .above_focused
    // .below_focused
    .default_attach_mode = .below_focused,

    // .csd
    // .ssd
    .default_window_decoration = .ssd,

    // window border
    .border = .{
        .width = 5,
        .color = .{
            .focus = 0xffc777ff,
            .unfocus = 0x828bb8ff,
            .swallowing = 0x0830e6ff,
        },
    },

    .layout = .{
        .scroller = .{
            .mfact = 0.5,
            .inner_gap = 16,
            .outer_gap = 9,
            // center the window when it is the only tiled one on the output
            .center_single = true,
        },
    },

    // key/pointer bindings
    .bindings = .{
        // repeat info for key repeat event, different with the repeat_info of input device
        .repeat_info = .{
            .rate = 50,
            .delay = 300,
        },

        // list of key bindings
        // full scheme:
        //       mode: string(< 16 bytes)
        //          "default" and "lock" are defined by default
        //          "default" is the default mode, if you not set `mode`, the binding will be seemed as "default" mode
        //          when the session locked, flat-wm will switch to "lock" mode
        //          you could define any other mode
        //       layout:
        //          xkb layout that should be used to translate key events for the purpose of triggering this key binding
        //          irrespective of the currently active xkb layout
        //          this field is a 0-indexed xkbcommon layout number for the keyboard that generated the key event
        //          by default this field is null so the currently active xkb layout of the keyboard that generated the key
        //          event will be used
        //       keysym: keysym string
        //       modifiers:
        //          a struct with fields: shift, ctrl, mod1, mod3, mod4, mod5, and all of these fields are `false` by default
        //          set modifiers to .{} means key binding without any modifier
        //       event: key binding trigger event
        //          there are two options:
        //              .event = .{
        //                  .repeat = action
        //              }
        //              after the key pressed, the action will repeatly trigger until key released or any another key pressed
        //
        //              .event = .{
        //                  .click = .{
        //                      .pressed = null or action, default is null
        //                      .released = null or action, default is null
        //                  }
        //              }
        //              the corrosponding action will only trigger once when key pressed or released
        //              the pressed action and released action could define at the same time
        .key = .{
            .{
                .keysym = "r",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .reload_config,
                    },
                },
            },

            // passthrough
            .{
                .keysym = "Escape",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .switch_mode = .{ .mode = "passthrough" },
                        },
                    },
                },
            },
            .{
                .mode = "passthrough",
                .keysym = "Escape",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .switch_mode = .{ .mode = "default" },
                        },
                    },
                },
            },

            // floating
            .{
                .keysym = "f",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .switch_mode = .{ .mode = "floating", .auto_quit = .once_unbound_pressed },
                        },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "l",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .repeat = .{
                        .move = .{ .step = .{ .horizontal = 10 } },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "h",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .repeat = .{
                        .move = .{ .step = .{ .horizontal = -10 } },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "j",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .repeat = .{
                        .move = .{ .step = .{ .vertical = 10 } },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "k",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .repeat = .{
                        .move = .{ .step = .{ .vertical = -10 } },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "l",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{
                    .repeat = .{
                        .resize = .{ .step = .{ .horizontal = 10 } },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "h",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{
                    .repeat = .{
                        .resize = .{ .step = .{ .horizontal = -10 } },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "j",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{
                    .repeat = .{
                        .resize = .{ .step = .{ .vertical = 10 } },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "k",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{
                    .repeat = .{
                        .resize = .{ .step = .{ .vertical = -10 } },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "l",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .snap = .{ .edge = .right },
                        },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "h",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .snap = .{ .edge = .left },
                        },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "j",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .snap = .{ .edge = .bottom },
                        },
                    },
                },
            },
            .{
                .mode = "floating",
                .keysym = "k",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .snap = .{ .edge = .top },
                        },
                    },
                },
            },

            // default
            .{
                .keysym = "q",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .quit = .{
                                .exit_session = true,
                                // command to run before quit
                                // will quit only when the process exit with zero status
                                // e.g. .{ "sh", "-c", "~/cleanup.sh" }
                                .hook = null,
                            },
                        },
                    },
                },
            },
            .{
                .keysym = "c",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .close,
                    },
                },
            },
            .{
                .keysym = "c",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .center,
                    },
                },
            },
            .{
                .keysym = "Return",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .zoom,
                    },
                },
            },
            .{
                .keysym = "b",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .toggle_bar,
                    },
                },
            },
            .{
                .keysym = "j",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .forward },
                        },
                    },
                },
            },
            .{
                .keysym = "k",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .reverse },
                        },
                    },
                },
            },
            .{
                .keysym = "j",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .forward, .skip = .floating },
                        },
                    },
                },
            },
            .{
                .keysym = "k",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_iter = .{ .direction = .reverse, .skip = .floating },
                        },
                    },
                },
            },
            .{
                .keysym = "j",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .swap = .{ .direction = .forward },
                        },
                    },
                },
            },
            .{
                .keysym = "k",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .swap = .{ .direction = .reverse },
                        },
                    },
                },
            },
            // Arrow-key navigation: reorder tiled windows horizontally and move them between rows vertically.
            .{
                .keysym = "Left",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .swap = .{ .direction = .reverse },
                        },
                    },
                },
            },
            .{
                .keysym = "Right",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .swap = .{ .direction = .forward },
                        },
                    },
                },
            },
            .{
                .keysym = "Up",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .set_window_tag = .{ .tag = .{ .direction = .reverse }, .focus_follow = true },
                        },
                    },
                },
            },
            .{
                .keysym = "Down",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .set_window_tag = .{ .tag = .{ .direction = .forward }, .focus_follow = true },
                        },
                    },
                },
            },
            // switch between the rows of the workspace
            .{
                .keysym = "Up",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .set_output_tag = .{ .tag = .{ .direction = .reverse } },
                        },
                    },
                },
            },
            .{
                .keysym = "Down",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .set_output_tag = .{ .tag = .{ .direction = .forward } },
                        },
                    },
                },
            },

            .{
                .keysym = "period",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_output_iter = .{ .direction = .forward },
                        },
                    },
                },
            },
            .{
                .keysym = "comma",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .focus_output_iter = .{ .direction = .reverse },
                        },
                    },
                },
            },
            .{
                .keysym = "period",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .send_to_output = .{ .direction = .forward },
                        },
                    },
                },
            },
            .{
                .keysym = "comma",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .send_to_output = .{ .direction = .reverse },
                        },
                    },
                },
            },
            .{
                .keysym = "m",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .toggle_fullscreen = .{ .in_window = true },
                        },
                    },
                },
            },
            .{
                .keysym = "f",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .toggle_fullscreen = .{ .in_window = false },
                        },
                    },
                },
            },
            .{
                .keysym = "e",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .toggle_maximize,
                    },
                },
            },
            .{
                .keysym = "f",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .toggle_floating,
                    },
                },
            },
            .{
                .keysym = "s",
                .modifiers = .{ .mod4 = true, .ctrl = true },
                .event = .{
                    .click = .{
                        .pressed = .toggle_sticky,
                    },
                },
            },
            .{
                .keysym = "a",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .toggle_swallow,
                    },
                },
            },
            .{
                .keysym = "Tab",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .switch_to_previous_tag,
                    },
                },
            },
            .{
                .keysym = "apostrophe",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .set_output_tag = .{ .tag = .{ .occupied = .forward } },
                        },
                    },
                },
            },
            .{
                .keysym = "semicolon",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .set_output_tag = .{ .tag = .{ .occupied = .reverse } },
                        },
                    },
                },
            },
            .{
                .keysym = "apostrophe",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .set_window_tag = .{ .tag = .{ .unoccupied = .forward } },
                        },
                    },
                },
            },
            .{
                .keysym = "semicolon",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .set_window_tag = .{ .tag = .{ .unoccupied = .reverse } },
                        },
                    },
                },
            },

            .{ .keysym = "1", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 1 } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 2 } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 3 } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 4 } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 5 } } } } },
            .{ .keysym = "6", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 6 } } } } },
            .{ .keysym = "7", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 7 } } } } },
            .{ .keysym = "8", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 8 } } } } },
            .{ .keysym = "9", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_workspace = .{ .workspace = 9 } } } } },

            .{ .keysym = "1", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 1 } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 2 } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 3 } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 4 } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 5 } } } } },
            .{ .keysym = "6", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 6 } } } } },
            .{ .keysym = "7", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 7 } } } } },
            .{ .keysym = "8", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 8 } } } } },
            .{ .keysym = "9", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 9 } } } } },

            // move the focused window to the workspace and follow it
            .{ .keysym = "1", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 1, .focus_follow = true } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 2, .focus_follow = true } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 3, .focus_follow = true } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 4, .focus_follow = true } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 5, .focus_follow = true } } } } },
            .{ .keysym = "6", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 6, .focus_follow = true } } } } },
            .{ .keysym = "7", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 7, .focus_follow = true } } } } },
            .{ .keysym = "8", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 8, .focus_follow = true } } } } },
            .{ .keysym = "9", .modifiers = .{ .mod4 = true, .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .set_window_workspace = .{ .workspace = 9, .focus_follow = true } } } } },

            .{
                .keysym = "l",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .modify_mfact = .{ .change = .{ .step = 0.01 } },
                        },
                    },
                },
            },
            .{
                .keysym = "h",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .modify_mfact = .{ .change = .{ .step = -0.01 } },
                        },
                    },
                },
            },
            .{
                .keysym = "equal",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .modify_gap = .{ .step = 1 },
                        },
                    },
                },
            },
            .{
                .keysym = "minus",
                .modifiers = .{ .mod4 = true, .mod1 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .modify_gap = .{ .step = -1 },
                        },
                    },
                },
            },
            .{
                .keysym = "a",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .toggle_auto_swallow,
                    },
                },
            },

            .{
                .keysym = "p",
                .modifiers = .{ .mod4 = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn_shell = .{ .cmd = "wmenu-run" },
                        },
                    },
                },
            },
            .{
                .keysym = "Return",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "foot" } },
                        },
                    },
                },
            },
        },

        // list of pointer bindings
        // full scheme:
        //       mode: same as key binding
        //       button: pointer button
        //          .left
        //          .right
        //          .middle
        //       modifiers: same as key binding
        //       event: pointer binding trigger event
        //              .event = .{
        //                  .pressed = null or action, default is null
        //                  .released = null or action, default is null
        //              }
        //              the corrosponding action will only trigger once when pointer button pressed or released
        //              the pressed action and released action could define at the same time
        .pointer = .{
            .{
                .mode = "default",
                .button = .left,
                .modifiers = .{ .mod4 = true },
                .event = .{ .pressed = .pointer_move },
            },
            .{
                .mode = "default",
                .button = .right,
                .modifiers = .{ .mod4 = true },
                .event = .{ .pressed = .pointer_resize },
            },
        },
        // other unmentioned actions:
        //      group: run multiple actions in sequence
        //         .event = .{
        //             .click = .{
        //                 .pressed = .{
        //                     .group = .{
        //                         .actions = .{
        //                             action1,
        //                             action2,
        //                             ...
        //                         },
        //                     },
        //                 },
        //             },
        //         }
    },

    // rule part
    //
    // a rule pattern has fields below:
    //      str: pattern string, required
    //      regex: bool, if enable regex
    //      match_null: bool, if match null
    //
    // only the first rule matched will be applied

    // window rules
    // full scheme:
    //      app_id: rule pattern
    //      title: rule pattern
    //
    //      workspace: window workspace, 1 for the first one
    //      tag: window rows in its workspace
    //      output: output name pattern, same as rule pattern
    //      floating: bool, if floating
    //      dimension: .{ .width = i32, .height = i32 }, initial dimension
    //      decoration: .csd or .ssd, window decoration
    //      is_terminal: bool, if set true, means the window could be swallowed
    //      disable_swallow: bool, if set true, the window could not swallow any other windows
    //      scroller_mfact: f32, initial mfact of the window
    //      attach_mode: like `default_attach_mode`, change attach_mode for window matched
    .window_rules = .{
        .{ .app_id = .{ .str = "", .match_null = true }, .floating = true },
        .{ .app_id = .{ .str = "zenity" }, .floating = true },
        .{ .app_id = .{ .str = "DesktopEditors" }, .floating = true },
        .{ .app_id = .{ .str = "xdg-desktop-portal-gtk" }, .floating = true },
        .{ .app_id = .{ .str = "chromium" }, .tag = 0b10, .scroller_mfact = 0.9 },
        .{ .app_id = .{ .str = "foot" }, .is_terminal = true, .scroller_mfact = 0.8 },
    },

    // output rules
    // full scheme:
    //      name: rule pattern
    //
    //      presentation_mode: presentation mode, .vsync or .async
    //      layout: same as `layout` before but you only need to specify the values you want to change
    .output_rules = .{
        //
    },
}
